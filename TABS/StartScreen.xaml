<Window x:Class="TABS.StartScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TABS Tracker"
        Height="720"
Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#16181B"
        FontFamily="Segoe UI"
                MouseDown="Window_MouseDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#313843"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CustomTitleBarRow" Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="CustomTitleBar"
        Grid.Row="0"
        Panel.ZIndex="10000"
        Background="#23272F"
                BorderBrush="#323A46"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed"
                MouseDown="CustomTitleBar_MouseDown"
MouseMove="CustomTitleBar_MouseMove"
MouseLeftButtonUp="CustomTitleBar_MouseLeftButtonUp">
            <Grid>
                <TextBlock Text="TABS Tracker"
                           Foreground="#E8EDF3"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Width="52" Height="40" Margin="0"
            Background="Transparent"
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Click="WindowMinimize_Click"/>

                    <Button Content="&#xE922;" Width="52" Height="40" Margin="0"
            Background="Transparent"
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Click="WindowMaximize_Click"/>

                    <Button Content="&#xE8BB;" Width="52" Height="40" Margin="0"
            Background="Transparent"
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Click="WindowClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Border Width="1280" Height="680" Background="#23272F" CornerRadius="18" Padding="22" Margin="18">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="AppNameText" Text="TABS Arena"
                                   Foreground="White" FontSize="34" FontWeight="Bold"/>
                        <TextBlock x:Name="ChooseModeText" Text="Choose Match Mode"
                                   Foreground="#A7ACB2" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
                            <Button x:Name="DiscordButton"
        Width="34" Height="34"
        Background="#313843"
        Margin="0,0,10,0"
        Click="DiscordButton_Click"
        ToolTip="Discord">
                                <Viewbox Width="19" Height="19">
                                    <Canvas Width="28" Height="24">
                                        <Path Fill="#5865F2"
                  Data="M23.52,4.87A22.2,22.2 0,0 0,17.93,3.15C17.69,3.58 17.41,4.16 17.22,4.62A20.72,20.72 0,0 0,10.99,4.62C10.8,4.16 10.51,3.58 10.27,3.15A22.12,22.12 0,0 0,4.68,4.87C1.14,10.13 0.18,15.25 0.66,20.3A22.35,22.35 0,0 0,7.51,23.75C8.06,23.01 8.55,22.22 8.97,21.39C8.16,21.08 7.39,20.7 6.66,20.25C6.85,20.11 7.04,19.96 7.22,19.82C11.67,21.88 16.5,21.88 20.9,19.82C21.08,19.96 21.27,20.11 21.46,20.25C20.73,20.7 19.95,21.08 19.14,21.39C19.56,22.22 20.05,23.01 20.6,23.75A22.3,22.3 0,0 0,27.46,20.3C28.03,14.44 26.5,9.37 23.52,4.87ZM9.53,17.19C8.2,17.19 7.11,15.97 7.11,14.47C7.11,12.97 8.18,11.75 9.53,11.75C10.88,11.75 11.98,12.98 11.95,14.47C11.95,15.97 10.88,17.19 9.53,17.19ZM18.47,17.19C17.14,17.19 16.05,15.97 16.05,14.47C16.05,12.97 17.12,11.75 18.47,11.75C19.82,11.75 20.92,12.98 20.89,14.47C20.89,15.97 19.82,17.19 18.47,17.19Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button x:Name="SettingsButton"
                                Width="34" Height="34"
                                Background="#313843"
                                Margin="0,0,10,0"
                                Click="SettingsButton_Click"
                                ToolTip="Settings">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                  Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="CloseButton"
                                Content="X"
                                Width="34" Height="34"
                                Background="#313843"
                                Foreground="#A7ACB2"
                                FontSize="13"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                    <Grid Grid.Row="1" Margin="0,26,0,22" Height="504" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1A1D23" BorderBrush="#8B3F3F"
                            BorderThickness="2" CornerRadius="14" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                <Border Background="#4A1F1F" CornerRadius="8" Padding="12,5" HorizontalAlignment="Center">
                                    <TextBlock Text="1v1" Foreground="#FFB4B4"
                                               FontSize="32" FontWeight="Bold"/>
                                </Border>

                                <TextBlock x:Name="OneVOneTitleText" Text="Duel"
                                           Foreground="White" FontSize="29" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock x:Name="OneVOneBodyText"
                                           Text="Two players, individual economy, fast round control."
                                           Foreground="#A7ACB2" FontSize="13" TextWrapping="Wrap"
                                           TextAlignment="Center" LineHeight="20" Margin="0,8,0,0"/>
                            </StackPanel>

                            <Button x:Name="OneVOneButton"
                                    Grid.Row="2"
                                    Content="Start 1v1"
                                    Height="46"
                                    Background="#8B3F3F"
                                    FontSize="15"
                                    Click="OneVOne_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#1A1D23" BorderBrush="#315F7D"
                            BorderThickness="2" CornerRadius="14" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                <Border Background="#1E3345" CornerRadius="8" Padding="12,5" HorizontalAlignment="Center">
                                    <TextBlock Text="2v2" Foreground="#7FC0E0"
                                               FontSize="32" FontWeight="Bold"/>
                                </Border>

                                <TextBlock x:Name="TwoVTwoTitleText" Text="Team Battle"
                                           Foreground="White" FontSize="29" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock x:Name="TwoVTwoBodyText"
                                           Text="Four players, shared team score, BFT, milestones, and faction tools."
                                           Foreground="#A7ACB2" FontSize="13" TextWrapping="Wrap"
                                           TextAlignment="Center" LineHeight="20" Margin="0,8,0,0"/>
                            </StackPanel>

                            <Button x:Name="TwoVTwoButton"
                                    Grid.Row="2"
                                    Content="Start 2v2"
                                    Height="46"
                                    Background="#315F7D"
                                    FontSize="15"
                                    Click="TwoVTwo_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="VersionText"
                           Grid.Row="2"
                           Text="TABS Arena v.1.1.2"
                           Foreground="#6B7280"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>
            </Border>
        </Viewbox>

        <Grid x:Name="SettingsOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#44000000"
              Panel.ZIndex="999">
            <Border Width="720" Height="370"
                    Background="#16181B"
                    CornerRadius="18"
                    BorderBrush="#323A46"
                    BorderThickness="1.5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#23272F"
                            CornerRadius="18,18,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SettingsBackButton"
                                    Grid.Column="0"
                                    Content="← Back"
                                    Height="40"
                                    Padding="18,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Background="#313843"
                                    Foreground="#7FC0E0"
                                    Click="SettingsBackButton_Click"/>

                            <TextBlock x:Name="SettingsTitleText"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Settings"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20">
                        <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SettingsWindowModeLabel"
                                           Grid.Column="0"
                                           Text="Window Mode"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F3"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="SettingsWindowModeLeft"
                                        Grid.Column="1"
                                        Content="&#x3C;"
                                        Width="28" Height="28"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Background="#313843"
                                        Foreground="#7FC0E0"
                                        Margin="0,0,8,0"
                                        Click="SettingsWindowModeLeft_Click"/>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SettingsWindowModeText"
                                               Text="Windowed"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#6EB6DA"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border x:Name="SettingsDot1" Width="28" Height="3" CornerRadius="2" Background="#6EB6DA" Margin="3,0"/>
                                        <Border x:Name="SettingsDot2" Width="28" Height="3" CornerRadius="2" Background="#3A4A58" Margin="3,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="SettingsWindowModeRight"
                                        Grid.Column="3"
                                        Content="&#x3E;"
                                        Width="28" Height="28"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Background="#313843"
                                        Foreground="#7FC0E0"
                                        Margin="8,0,0,0"
                                        Click="SettingsWindowModeRight_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SettingsLanguageLabel"
                                           Grid.Column="0"
                                           Text="Language"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F3"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="SettingsLanguageLeft"
                                        Grid.Column="1"
                                        Content="&#x3C;"
                                        Width="28" Height="28"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Background="#313843"
                                        Foreground="#7FC0E0"
                                        Margin="0,0,8,0"
                                        Click="SettingsLanguageLeft_Click"/>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SettingsLanguageText"
                                               Text="English"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#6EB6DA"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border x:Name="SettingsLangDot1" Width="28" Height="3" CornerRadius="2" Background="#6EB6DA" Margin="3,0"/>
                                        <Border x:Name="SettingsLangDot2" Width="28" Height="3" CornerRadius="2" Background="#3A4A58" Margin="3,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="SettingsLanguageRight"
                                        Grid.Column="3"
                                        Content="&#x3E;"
                                        Width="28" Height="28"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Background="#313843"
                                        Foreground="#7FC0E0"
                                        Margin="8,0,0,0"
                                        Click="SettingsLanguageRight_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SettingsSoundsLabel"
                                           Grid.Column="0"
                                           Text="Sounds"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F3"
                                           VerticalAlignment="Center"/>

                                <ToggleButton x:Name="SettingsSoundsToggleButton"
                                              Grid.Column="1"
                                              Content="Sounds: On"
                                              Style="{StaticResource SoundToggleStyle}"
                                              Click="SettingsSoundsToggleButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SettingsSoundVolumeLabel"
                                           Grid.Column="0"
                                           Text="Volume"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F3"
                                           VerticalAlignment="Center"/>

                                <Slider x:Name="SettingsSoundVolumeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        Style="{StaticResource SoundSliderStyle}"
                                        VerticalAlignment="Center"
                                        ValueChanged="SettingsSoundVolumeSlider_ValueChanged"/>

                                <TextBlock x:Name="SettingsSoundVolumeText"
                                           Grid.Column="2"
                                           Text="100%"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#6EB6DA"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
