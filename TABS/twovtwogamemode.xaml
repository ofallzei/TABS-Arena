                </Border>
            </Grid>

            <!-- Settings Overlay -->
            <Grid x:Name="SettingsOverlay"
                  Visibility="Collapsed"
                  Grid.RowSpan="4"
                  Background="#44000000"
                  Panel.ZIndex="999">
                <Border Width="720" Height="780"
                        Background="#16181B"
                        CornerRadius="18"
                        BorderBrush="#323A46"
                        BorderThickness="1.5"
                        VerticalAlignment="Top"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#23272F"
                                CornerRadius="18,18,0,0"
                                Padding="14,12,14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="SettingsBackButton"
                                        Content="← Back"
                                        Height="40" Padding="18,0"
                                        FontSize="14" FontWeight="SemiBold"
                                        Background="#313843" Foreground="#7FC0E0"
                                        BorderThickness="0"
                                        Click="SettingsBackButton_Click"/>
                                <TextBlock x:Name="SettingsTitleText"
           Grid.Column="0" Grid.ColumnSpan="2"
           Text="Settings"
           FontSize="18" FontWeight="Bold"
           Foreground="White"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      x:Name="SettingsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="20"
                                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                            <StackPanel x:Name="SettingsContentPanel" Margin="0">

                                <Border Background="#23272F"
                                        CornerRadius="10"
                                        Padding="16,0"
                                        Height="52"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
           x:Name="SettingsWindowModeLabel"
           Text="Window Mode"
           FontSize="13" FontWeight="SemiBold"
           Foreground="#E2E8F3"
           VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                x:Name="SettingsWindowModeLeft"
                                                Content="&#x3C;"
                                                Width="28" Height="28"
                                                FontSize="14" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0"
                                                Margin="0,0,8,0"
                                                Click="SettingsWindowModeLeft_Click"/>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="SettingsWindowModeText"
                                                       Text="Borderless Fullscreen"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#6EB6DA"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Border x:Name="SettingsDot1"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#6EB6DA"
                                                        Margin="3,0"/>
                                                <Border x:Name="SettingsDot2"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#3A4A58"
                                                        Margin="3,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                x:Name="SettingsWindowModeRight"
                                                Content="&#x3E;"
                                                Width="28" Height="28"
                                                FontSize="14" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0"
                                                Margin="8,0,0,0"
                                                Click="SettingsWindowModeRight_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#23272F"
                                        CornerRadius="10"
                                        Padding="16,0"
                                        Height="52"
                                        Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   x:Name="SettingsLanguageLabel"
                                                   Text="Language"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E2E8F3"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                x:Name="SettingsLanguageLeft"
                                                Content="&#x3C;"
                                                Width="28" Height="28"
                                                FontSize="14" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0"
                                                Margin="0,0,8,0"
                                                Click="SettingsLanguageLeft_Click"/>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,5">
                                                <Grid x:Name="SettingsLanguageFlag"
                                                      Width="24" Height="16"
                                                      ClipToBounds="True"
                                                      Margin="0,0,7,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SettingsLanguageText"
                                                           Text="English"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#6EB6DA"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Border x:Name="SettingsLangDot1"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#6EB6DA"
                                                        Margin="3,0"/>
                                                <Border x:Name="SettingsLangDot2"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#3A4A58"
                                                        Margin="3,0"/>
                                                <Border x:Name="SettingsLangDot3"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#3A4A58"
                                                        Margin="3,0"/>
                                                <Border x:Name="SettingsLangDot4"
                                                        Width="28" Height="3"
                                                        CornerRadius="2"
                                                        Background="#3A4A58"
                                                        Margin="3,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                x:Name="SettingsLanguageRight"
                                                Content="&#x3E;"
                                                Width="28" Height="28"
                                                FontSize="14" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0"
                                                Margin="8,0,0,0"
                                                Click="SettingsLanguageRight_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#23272F"
                                        CornerRadius="10"
                                        Padding="16,0"
                                        Height="52"
                                        Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   x:Name="SettingsSoundsLabel"
                                                   Text="Sounds"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E2E8F3"
                                                   VerticalAlignment="Center"/>

                                        <ToggleButton Grid.Column="1"
                                                      x:Name="SettingsSoundsToggleButton"
                                                      Content="Sounds: On"
                                                      Style="{StaticResource SoundToggleStyle}"
                                                      Click="SettingsSoundsToggleButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#23272F"
                                        CornerRadius="10"
                                        Padding="16,0"
                                        Height="52"
                                        Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="54"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   x:Name="SettingsSoundVolumeLabel"
                                                   Text="Volume"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E2E8F3"
                                                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
                                                x:Name="SettingsSoundVolumeSlider"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="100"
                                                Style="{StaticResource SoundSliderStyle}"
                                                VerticalAlignment="Center"
                                                ValueChanged="SettingsSoundVolumeSlider_ValueChanged"/>

                                        <TextBlock Grid.Column="2"
                                                   x:Name="SettingsSoundVolumeText"
                                                   Text="100%"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#6EB6DA"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
