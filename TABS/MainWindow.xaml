                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="20"
                                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                            <StackPanel x:Name="SettingsContentPanel" Margin="0">
                                <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" x:Name="SettingsWindowModeLabel"
                                                   Text="Window Mode"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E2E8F3"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" x:Name="SettingsWindowModeLeft"
                                                Content="&#x3C;" Width="28" Height="28"
                                                FontSize="13" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Margin="0,0,8,0"
                                                Click="SettingsWindowModeLeft_Click"/>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="SettingsWindowModeText"
                                                       Text="Borderless Fullscreen"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#6EB6DA"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border x:Name="SettingsDot1" Width="28" Height="3" CornerRadius="2" Background="#3A4A58" Margin="3,0"/>
                                                <Border x:Name="SettingsDot2" Width="28" Height="3" CornerRadius="2" Background="#6EB6DA" Margin="3,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="3" x:Name="SettingsWindowModeRight"
                                                Content="&#x3E;" Width="28" Height="28"
                                                FontSize="13" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Margin="8,0,0,0"
                                                Click="SettingsWindowModeRight_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#23272F" CornerRadius="10" Padding="16,0" Height="52" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" x:Name="SettingsLanguageLabel"
                                                   Text="Language"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E2E8F3"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" x:Name="SettingsLanguageLeft"
                                                Content="&#x3C;" Width="28" Height="28"
                                                FontSize="13" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Margin="0,0,8,0"
                                                Click="SettingsLanguageLeft_Click"/>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="SettingsLanguageText"
                                                       Text="English"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#6EB6DA"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border x:Name="SettingsLangDot1" Width="28" Height="3" CornerRadius="2" Background="#6EB6DA" Margin="3,0"/>
                                                <Border x:Name="SettingsLangDot2" Width="28" Height="3" CornerRadius="2" Background="#3A4A58" Margin="3,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="3" x:Name="SettingsLanguageRight"
                                                Content="&#x3E;" Width="28" Height="28"
                                                FontSize="13" FontWeight="Bold"
                                                Background="#313843" Foreground="#7FC0E0"
                                                BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Margin="8,0,0,0"
                                                Click="SettingsLanguageRight_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GuideOverlay"
                  Visibility="Collapsed"
                  Grid.RowSpan="3"
                  Grid.ColumnSpan="2"
                  Background="#44000000"
                  Panel.ZIndex="1000">
                <Border Width="720" Height="720"
        Background="#16181B"
                        CornerRadius="18"
                        BorderBrush="#323A46"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,20,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#23272F"
        CornerRadius="18,18,0,0"
        Padding="14,12,14,12">
                            <Grid>
                                <Button x:Name="GuideBackButton"
        Content="← Back"
        Height="32"
        Padding="14,0"
        FontSize="12"
        FontWeight="SemiBold"
        Background="#313843"
        Foreground="#7FC0E0"
        BorderThickness="0"
        HorizontalAlignment="Left"
        Click="GuideBackButton_Click"/>
                                <TextBlock x:Name="GuideTitleText"
                                           Text="1v1 Guide"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="20">
                            <StackPanel x:Name="GuideContentPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>